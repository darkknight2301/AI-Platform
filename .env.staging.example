# Staging — copy to .env.staging and fill in real values. Same shape
# as .env.production.example; staging exists to catch problems (config
# drift, migration issues, real-ish load) before they reach production,
# so keep it as close to production as practical. See DEPLOYMENT.md.

ENVIRONMENT=staging
SERVER_NAME=staging.app.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value

DATABASE_URL=postgresql+asyncpg://app_user:REPLACE_ME@staging-db.internal:5432/app_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

CORS_ALLOW_ORIGINS=https://staging.app.example.com

# Fewer replicas than production — staging traffic is low, and this
# keeps staging cheap to run.
BACKEND_REPLICAS=1
WEB_CONCURRENCY=2

SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_CERT_DIR=./ssl/staging

# Point at a real (possibly smaller/shared) inference server, or leave
# both disabled to exercise the full app without real model output.
QWEN_CODER_ENABLED=false
QWEN_CODER_ENDPOINT_URL=
QWEN_NLP_ENABLED=false
QWEN_NLP_ENDPOINT_URL=
