# Copy this file to .env for local development and fill in real values.
# NEVER commit a .env file with real secrets.

# --- Core ---------------------------------------------------------------
APP_NAME="AI Platform API"
ENVIRONMENT=development        # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# --- Database ---------------------------------------------------------------
# Production/staging: PostgreSQL via asyncpg.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/app_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- CORS ---------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting (foundation only; enforced in a later phase) --------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
