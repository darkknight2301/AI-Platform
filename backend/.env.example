# Copy this file to .env for local development and fill in real values.
# NEVER commit a .env file with real secrets.

# --- Core ---------------------------------------------------------------
APP_NAME="AI Platform API"
ENVIRONMENT=development        # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# --- Database ---------------------------------------------------------------
# Production/staging: PostgreSQL via asyncpg.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/app_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- CORS ---------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting / brute-force protection -----------------------------
# Per-client, enforced by RateLimitMiddleware. Login lockout (5 failed
# attempts / 15 min per identifier) is separate and always on — see
# src/services/auth_service.py.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Only set to true when the backend is reachable EXCLUSIVELY through a
# reverse proxy that itself sets X-Forwarded-For/X-Real-IP (nginx's
# config here does — see nginx/nginx.conf.template). If the backend is
# ever reachable directly (as it is in local dev), leave this false —
# otherwise a caller can forge these headers and bypass rate limiting
# entirely. docker-compose.prod.yml sets this to true because the
# backend there is `expose`-only, never published on the host.
TRUST_PROXY_HEADERS=false

# Optional. When set, RateLimitMiddleware uses this Redis instance for a
# shared, cross-replica counter instead of an in-memory, per-process one
# (see PERFORMANCE.md's "Scalability bottlenecks" — a process-local
# counter under-enforces once more than one backend replica is running).
# Leave unset for local/single-instance development.
RATE_LIMIT_REDIS_URL=

# --- Quotas (Phase 7) --------------------------------------------------
# Global defaults; group/user overrides are set via the admin API
# (PATCH /admin/groups/{id}, PATCH /admin/users/{id}), not env vars.
DEFAULT_MAX_ACTIVE_CHATS=20
DEFAULT_TOKEN_QUOTA=100000
# ROLLING_24H (trailing 24h, continuously sliding) or DAILY_RESET_UTC
# (fixed UTC-midnight reset) — see ADR 0010.
TOKEN_QUOTA_RENEWAL_POLICY=ROLLING_24H
# Conservative per-request token estimate used only to reserve quota
# for the duration of an in-flight model call — never used for actual
# accounting, which is always the provider-reported usage.
QUOTA_RESERVATION_ESTIMATED_OUTPUT_TOKENS=2048

# --- Model layer: Qwen providers (Phase 5) -----------------------------
# Both default to disabled — the app starts fine with neither set.
# Enable one/both once a real OpenAI-compatible inference server (e.g.
# vLLM, TGI) is running and reachable at the configured endpoint.
# No machine-specific paths are set by default; MODEL_PATH is only
# forwarded to the backend as the request's `model` field / used for
# descriptive metadata — it is not read from disk by this application.

QWEN_CODER_ENABLED=false
QWEN_CODER_MODEL_PATH=Qwen/Qwen2.5-Coder-7B-Instruct
QWEN_CODER_ENDPOINT_URL=http://localhost:8001/v1
QWEN_CODER_API_KEY=
QWEN_CODER_CONTEXT_LENGTH=32768
QWEN_CODER_MAX_OUTPUT_TOKENS=4096
QWEN_CODER_TEMPERATURE=0.2
QWEN_CODER_STREAMING_ENABLED=true
QWEN_CODER_REQUEST_TIMEOUT_SECONDS=60
QWEN_CODER_DEVICE=cuda
QWEN_CODER_DTYPE=bfloat16
QWEN_CODER_GPU_MEMORY_FRACTION=0.9

QWEN_NLP_ENABLED=false
QWEN_NLP_MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
QWEN_NLP_ENDPOINT_URL=http://localhost:8002/v1
QWEN_NLP_API_KEY=
QWEN_NLP_CONTEXT_LENGTH=32768
QWEN_NLP_MAX_OUTPUT_TOKENS=4096
QWEN_NLP_TEMPERATURE=0.7
QWEN_NLP_STREAMING_ENABLED=true
QWEN_NLP_REQUEST_TIMEOUT_SECONDS=60
QWEN_NLP_DEVICE=cuda
QWEN_NLP_DTYPE=bfloat16
QWEN_NLP_GPU_MEMORY_FRACTION=0.9

# --- ILA agent (ADR 0012) ------------------------------------------------
# Off by default — with ILA_ENABLED unset/false, the agent layer
# registers nothing and every existing Qwen-only chat path is
# unaffected. See src/agent_layer/.
ILA_ENABLED=false
# Dotted import path to the module containing the ILA class, e.g.
# "ila_engineering_agent" for `from ila_engineering_agent import ILA`.
ILA_MODULE_PATH=
ILA_CLASS_NAME=ILA
# JSON object, forwarded verbatim as ILA(**kwargs) — not a fixed set
# of named env vars, since ILA's constructor is owned by the ILA
# module, not this platform. Example: {"tools": ["search"]}
ILA_CONSTRUCTOR_KWARGS={}
# Registered model_key (e.g. qwen2.5-coder-7b) ILA is handed for its
# own model calls via the platform's existing ModelRouter. Optional.
ILA_DEFAULT_MODEL_KEY=
# ILA(**kwargs).main(query=...) is a blocking call, run in a thread
# with this timeout.
ILA_TIMEOUT_SECONDS=300

# --- Workspace / Web IDE (ADR 0012 §Web IDE) -----------------------------
# Off by default. Browser never sees SSH credentials — see
# src/agent_layer/workspace/. Terminal is disabled by design
# (WORKSPACE_TERMINAL_ENABLED left false; enforced in workspace_service.py's
# is_forbidden_route, not just this flag).
WORKSPACE_ENABLED=false
WORKSPACE_SSH_KEY_PATH=
WORKSPACE_SSH_USERNAME=workspace
WORKSPACE_SSH_PORT=22
WORKSPACE_DEFAULT_HOST=
WORKSPACE_ROOT=/srv/workspaces
WORKSPACE_CODE_SERVER_BIN=code-server
WORKSPACE_PORT_RANGE_START=9000
WORKSPACE_PORT_RANGE_END=9100
WORKSPACE_IDLE_TIMEOUT_SECONDS=1800
WORKSPACE_TERMINAL_ENABLED=false

# --- Model concurrency / queueing (Phase 11) ----------------------------
# Caps concurrent in-flight requests per model_key at the ModelRouter
# seam (src/model_layer/router.py) — see PERFORMANCE.md. Tune to the
# real inference backend's measured concurrent capacity; too high
# defeats the point, too low queues requests that the backend could
# actually have handled.
MODEL_MAX_CONCURRENT_REQUESTS_PER_MODEL=4
