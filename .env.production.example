# Production — copy to .env.production and fill in real values.
# NEVER commit this file. See DEPLOYMENT.md, "Production credentials".

ENVIRONMENT=production
SERVER_NAME=app.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must differ from staging/development — a shared SECRET_KEY across
# environments means a leaked staging token is a valid production token.
SECRET_KEY=replace-with-a-long-random-value

# Managed Postgres strongly recommended in production (automated
# backups, point-in-time recovery, failover) — see DEPLOYMENT.md,
# "Database". Credentials come from your secrets manager, not this
# file in version control (this .example file is a template only).
DATABASE_URL=postgresql+asyncpg://app_user:REPLACE_ME@prod-db.internal:5432/app_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

CORS_ALLOW_ORIGINS=https://app.example.com

BACKEND_REPLICAS=4
WEB_CONCURRENCY=4

SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_CERT_DIR=./ssl/production

QWEN_CODER_ENABLED=true
QWEN_CODER_ENDPOINT_URL=http://qwen-coder.internal:8001/v1
QWEN_NLP_ENABLED=true
QWEN_NLP_ENDPOINT_URL=http://qwen-nlp.internal:8002/v1
